{
  "name": "sealdice-log-enhanced",
  "version": "1.2.1",
  "private": true,
  "allowScripts": {
    "esbuild@0.27.1": true,
    "sealwrapper@0.1.0": true
  },
  "type": "module",
  "engines": {
    "node": ">=26.5.0 <27",
    "npm": ">=12.0.1 <13"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "./sealw watch --once --target 1.6.0",
    "check": "npm run format:check && npm run typecheck && npm test",
    "core:sync": "./sealw core sync --target 1.6.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run types:sync && ./sealw package --target 1.6.0",
    "scenario": "./sealw scenario test --target 1.6.0",
    "smoke": "./sealw test --target 1.6.0",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "typecheck": "npm run types:sync && ./sealw typecheck --target 1.6.0",
    "types:sync": "./sealw types sync --target 1.6.0",
    "verify": "npm run check && npm run smoke && npm run scenario",
    "watch": "./sealw watch --target 1.6.0"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "sealwrapper": "git+https://github.com/BegoniaStar/sealwrapper.git#ea5a0fe9dc7bd6fc6647c91280e8f0e04c22ce4d"
  }
}
